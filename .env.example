# ============================================================================
# AI Crypto Trading Terminal - Environment Configuration (.env.example)
# Copy to .env for local development. NEVER commit .env or real API keys.
# ============================================================================

# Application
APP_NAME=AI Crypto Trading Terminal
APP_ENV=development
APP_HOST=[IP]
APP_PORT=8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://[IP]:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://[IP]:8000

# Database
# Production and multi-process worker supervision strictly require PostgreSQL.
# SQLite does NOT provide cross-process transactional outbox locking (FOR UPDATE SKIP LOCKED)
# and background workers will refuse to boot against SQLite unless --allow-unsafe-sqlite is passed.
# PostgreSQL connection string format (PostgreSQL 14+ / psycopg v3 driver):
# DATABASE_URL=postgresql+psycopg://terminal_user:strong_password@[IP]:5432/ai_crypto_terminal
#
# REQUIRE_DB_DIALECT: "postgresql" (default/enforced in production), "sqlite", or "any"
REQUIRE_DB_DIALECT=postgresql
# Set DB_POLICY_ALLOW_SQLITE_IN_PRODUCTION=true only for non-standard standalone debugging:
DB_POLICY_ALLOW_SQLITE_IN_PRODUCTION=false

# For standalone local execution without Docker (SQLite with Decimal preservation).
# Note: Background workers require --allow-unsafe-sqlite flag when running against SQLite.
# Relative paths are resolved against the repository root, not the process CWD.
DATABASE_URL=sqlite:///data/terminal.db
POSTGRES_USER=terminal_user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=ai_crypto_terminal
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://[IP]:6379/0
REDIS_PORT=6379

# Security & Secret Encryption
# Master key is stored in macOS Keychain / OS Credential Store by default.
# Optional fallback key ID for local credential manager:
LOCAL_SECRET_FALLBACK_KEY_HEX=
ENCRYPTION_MASTER_KEY=

# Trading Mode & Safety Locks
DEFAULT_TRADING_ENVIRONMENT=demo
LIVE_TRADING_ENABLED=false
LIVE_MAX_ORDER_NOTIONAL_USDT=100.00
AUTO_TRADING_ENABLED=false
RECOVERY_CHECKPOINT_TTL_SECONDS=90

# Default Conservative Risk Limits (Stage 5)
DEFAULT_MAX_RISK_PER_TRADE_PCT=0.0025
DEFAULT_MAX_DAILY_LOSS_PCT=0.0100
DEFAULT_MAX_TOTAL_EXPOSURE_PCT=0.3000
DEFAULT_MAX_SYMBOL_EXPOSURE_PCT=0.1500
DEFAULT_MAX_OPEN_POSITIONS=3
DEFAULT_MAX_LEVERAGE=2
DEFAULT_MAX_SLIPPAGE_BPS=25
DEFAULT_MAX_SPREAD_BPS=20
DEFAULT_MAX_DATA_STALE_SECONDS=30
DEFAULT_MAX_CONSECUTIVE_API_FAILURES=3
DEFAULT_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_MAX_DAILY_TRADES=20

# AI Provider Configuration (No exchange secrets are ever sent to AI providers)
# AI_PROVIDER options:
#   rule_assisted_mock   -> deterministic, offline, no network/cost (default for tests & CI)
#   openai_compatible    -> any OpenAI-compatible /v1/chat/completions endpoint
AI_PROVIDER=rule_assisted_mock
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1

# Exchange Endpoints (Demo / Testnet Defaults)
BINANCE_SPOT_REST_URL=https://testnet.binance.vision
BINANCE_FUTURES_REST_URL=https://testnet.binancefuture.com
OKX_REST_URL=https://www.okx.com
OKX_SIMULATED_TRADING=1
